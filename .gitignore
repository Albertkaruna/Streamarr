# Whitelist: only hand-made config goes to GitHub.
# Secrets (.env, credentials.txt, nzb360-settings.txt, sockseek.conf, app config.xml) and app databases
# stay out — they're in the weekly archive in /mnt/data/Backups + Google Drive instead.
/*
!/.gitignore
!/docker-compose.yml
!/README.md
!/backup.sh
!/restore.sh
!/trakt_sync.py
!/homepage/
/homepage/logs/
!/jellyfin-branding/
!/system/
!/tunarr/
/tunarr/*
!/tunarr/tunarr.py
!/config/
/config/*
!/config/qbittorrent/
/config/qbittorrent/*
!/config/qbittorrent/order_queue.py
